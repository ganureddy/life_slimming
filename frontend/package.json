{
  "name": "lifescc",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start-ui":"./node_modules/http-server/bin/http-server ./dist/lifescc",
    "start": "node --max_old_space_size=2048 ./node_modules/@angular/cli/bin/ng serve",
    "build": "./node_modules/@angular/cli/bin/ng build --prod --deploy-url=/assets/life_slimming/frontend/ && yarn copy-html-entry",
		"copy-html-entry": "cp ../life_slimming/public/frontend/index.html ../life_slimming/www/frontend.html",
    "test": "./node_modules/@angular/cli/bin/ng test",
    "lint": "./node_modules/@angular/cli/bin/ng lint",
    "e2e": "./node_modules/@angular/cli/bin/ng e2e",
    "large-serve": "node --max_old_space_size=7168 ./node_modules/@angular/cli/bin/ng serve --aot"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^12.1.4",
    "@angular/common": "^12.1.4",
    "@angular/compiler": "^12.1.4",
    "@angular/core": "^12.1.4",
    "@angular/forms": "^12.1.4",
    "@angular/platform-browser": "^12.1.4",
    "@angular/platform-browser-dynamic": "^12.1.4",
    "@angular/router": "^12.1.4",
    "@ng-bootstrap/ng-bootstrap": "^12.1.2",
    "@ng-select/ng-select": "^5.0.9",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.2",
    "jquery": "^3.7.1",
    "moment": "^2.30.0",
    "ngx-toastr": "^13.2.1",
    "popper.js": "^1.16.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^12.1.4",
    "@angular/cli": "^12.1.4",
    "@angular/compiler-cli": "^12.1.4",
    "@types/jasmine": "~4.0.0",
    "@types/jquery": "^3.5.29",
    "jasmine-core": "~4.1.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "typescript": ">=4.2.3 and <4.4.0"
  }
}
