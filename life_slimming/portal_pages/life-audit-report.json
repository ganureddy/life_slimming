{"route":"life-audit-report","name":"life-audit-report","modified":"2026-09-07 20:41:21.714308","title":"Life Audit Report","html":"<div id=\"life-discount-report\"></div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n\n#life-discount-report,\n#life-discount-report * { box-sizing: border-box; }\n\n#life-discount-report {\n  --navy: #123f35;\n  --blue: #16855b;\n  --blue-soft: #e9f8f1;\n  --green: #16855b;\n  --green-soft: #e9f8f1;\n  --orange: #d97706;\n  --orange-soft: #fff5e6;\n  --red: #c33d3d;\n  --red-soft: #fff0f0;\n  --text: #243b53;\n  --muted: #718096;\n  --line: #e4eaf0;\n  --surface: #ffffff;\n  --page: #f5f8fb;\n  font-family: 'Poppins', sans-serif;\n  color: var(--text);\n  background: var(--page);\n  min-height: 100vh;\n  padding: 22px;\n}\n\n.ldr-shell { max-width: 1680px; margin: 0 auto; }\n\n.ldr-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 16px;\n  margin-bottom: 18px; padding: 21px 24px; border-radius: 16px;\n  background: linear-gradient(135deg, #0f6b4d 0%, #16855b 55%, #28a879 100%);\n  box-shadow: 0 12px 28px rgba(15, 107, 77, .18);\n}\n\n.ldr-title { margin: 0; color: #fff; font-size: 25px; font-weight: 700; }\n.ldr-subtitle { margin: 5px 0 0; color: #d9f6e9; font-size: 12px; }\n\n.ldr-card {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 14px;\n  box-shadow: 0 5px 18px rgba(28, 55, 90, .06);\n}\n\n.ldr-filter-card { padding: 16px; margin-bottom: 16px; }\n.ldr-quick-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 13px; }\n.ldr-quick-btn { height: 34px; padding: 0 13px; border: 1px solid #d7e3ee; border-radius: 8px; background: #f7fafc; color: #52677b; font: 600 11px 'Poppins', sans-serif; cursor: pointer; }\n.ldr-quick-btn:hover, .ldr-quick-btn.active { color: #fff; border-color: var(--blue); background: var(--blue); }\n.ldr-filters { display: grid; grid-template-columns: .9fr .9fr 1.15fr 1fr .8fr 1.4fr auto; gap: 12px; align-items: end; }\n.ldr-field label { display: block; margin: 0 0 6px; color: #52677b; font-size: 11px; font-weight: 600; }\n\n.ldr-input {\n  width: 100%; height: 42px; padding: 0 12px;\n  border: 1px solid #d7e0e8; border-radius: 9px;\n  background: #fff; color: var(--text); font: 500 12px 'Poppins', sans-serif;\n  outline: none; transition: .2s ease;\n}\n.ldr-input:focus { border-color: #77aee0; box-shadow: 0 0 0 3px rgba(23,105,170,.10); }\n\n.ldr-actions { display: flex; gap: 8px; }\n.ldr-btn {\n  height: 42px; padding: 0 15px; border: 0; border-radius: 9px;\n  font: 600 12px 'Poppins', sans-serif; cursor: pointer; white-space: nowrap;\n  display: inline-flex; align-items: center; justify-content: center; gap: 7px;\n  transition: transform .15s ease, opacity .15s ease;\n}\n.ldr-btn:hover { transform: translateY(-1px); }\n.ldr-btn:disabled { opacity: .55; cursor: not-allowed; transform: none; }\n.ldr-btn-primary { color: #fff; background: var(--blue); }\n.ldr-btn-export { color: #fff; background: var(--green); }\n.ldr-btn-light { color: var(--text); background: #edf2f7; }\n\n.ldr-summary { display: grid; grid-template-columns: repeat(6, minmax(145px, 1fr)); gap: 12px; margin-bottom: 16px; }\n.ldr-stat { padding: 15px 16px; min-height: 91px; position: relative; overflow: hidden; }\n.ldr-stat::after { content: ''; position: absolute; width: 58px; height: 58px; border-radius: 50%; right: -18px; top: -16px; background: currentColor; opacity: .08; }\n.ldr-stat-label { color: var(--muted); font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .35px; }\n.ldr-stat-value { margin-top: 8px; color: var(--navy); font-size: 20px; line-height: 1.2; font-weight: 700; }\n.ldr-stat.invoice { color: var(--blue); }\n.ldr-stat.sales { color: #725ac1; }\n.ldr-stat.paid { color: var(--green); }\n.ldr-stat.discount { color: var(--orange); }\n.ldr-stat.outstanding { color: var(--red); }\n\n.ldr-table-card { overflow: hidden; }\n.ldr-table-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--line); }\n.ldr-result-count { font-size: 12px; color: var(--muted); }\n.ldr-table-wrap { overflow: auto; max-height: calc(100vh - 360px); min-height: 280px; }\n.ldr-table { width: 100%; min-width: 1740px; border-collapse: separate; border-spacing: 0; }\n.ldr-table th { position: sticky; top: 0; z-index: 2; padding: 11px 12px; background: #f0f5fa; color: #52677b; border-bottom: 1px solid #dce4ec; font-size: 10px; font-weight: 700; text-align: left; white-space: nowrap; text-transform: uppercase; letter-spacing: .3px; }\n.ldr-table td { padding: 11px 12px; border-bottom: 1px solid #edf1f5; font-size: 11px; vertical-align: top; background: #fff; }\n.ldr-table tbody tr:hover td { background: #f8fbff; }\n.ldr-link { color: var(--blue); font-weight: 600; text-decoration: none; }\n.ldr-link:hover { text-decoration: underline; }\n.ldr-money { white-space: nowrap; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }\n.ldr-table td[title] { cursor: help; text-decoration: underline dotted #82b9a5; text-underline-offset: 3px; }\n.ldr-muted { color: var(--muted); }\n.ldr-approver { min-width: 190px; line-height: 1.55; }\n.ldr-view-btn { height: 30px; padding: 0 11px; border: 1px solid #b8dfcf; border-radius: 7px; color: var(--green); background: var(--green-soft); font: 600 10px 'Poppins', sans-serif; cursor: pointer; white-space: nowrap; }\n.ldr-view-btn:hover { color: #fff; background: var(--green); }\n\n.ldr-modal-backdrop { position: fixed; inset: 0; z-index: 100000; display: none; align-items: center; justify-content: center; padding: 22px; background: rgba(13, 39, 32, .58); backdrop-filter: blur(3px); }\n.ldr-modal-backdrop.show { display: flex; }\n.ldr-modal { width: min(920px, 100%); max-height: 92vh; overflow: auto; background: #fff; border-radius: 18px; box-shadow: 0 28px 80px rgba(0,0,0,.28); animation: ldr-modal-in .2s ease; }\n@keyframes ldr-modal-in { from { opacity: 0; transform: translateY(12px) scale(.985); } }\n.ldr-modal-head { position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 19px 22px; color: #fff; background: linear-gradient(135deg, #0f6b4d, #21a373); }\n.ldr-modal-head h2 { margin: 0; color: #fff; font-size: 18px; }\n.ldr-modal-head p { margin: 3px 0 0; color: #d9f6e9; font-size: 10px; }\n.ldr-modal-close { width: 36px; height: 36px; border: 1px solid rgba(255,255,255,.35); border-radius: 50%; color: #fff; background: rgba(255,255,255,.12); font-size: 22px; cursor: pointer; }\n.ldr-modal-body { padding: 20px 22px 24px; }\n.ldr-modal-section { margin-bottom: 18px; }\n.ldr-modal-section:last-child { margin-bottom: 0; }\n.ldr-section-title { margin: 0 0 10px; color: #447064; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .55px; }\n.ldr-detail-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }\n.ldr-detail { padding: 12px 13px; border: 1px solid #e2eee9; border-radius: 10px; background: #fbfdfc; }\n.ldr-detail-label { color: var(--muted); font-size: 9px; font-weight: 600; text-transform: uppercase; }\n.ldr-detail-value { margin-top: 5px; color: var(--text); font-size: 12px; font-weight: 600; word-break: break-word; }\n.ldr-finance-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }\n.ldr-finance { padding: 14px; border-radius: 11px; background: var(--green-soft); }\n.ldr-finance.discount { background: var(--orange-soft); }\n.ldr-finance.outstanding { background: var(--red-soft); }\n.ldr-finance .ldr-detail-value { font-size: 16px; }\n.ldr-modal-note { padding: 13px 14px; border-left: 3px solid var(--green); border-radius: 8px; background: #f2faf6; font-size: 11px; line-height: 1.65; }\n.ldr-modal-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 18px; }\n\n.ldr-badge { display: inline-flex; align-items: center; padding: 4px 8px; border-radius: 99px; font-size: 9px; font-weight: 700; white-space: nowrap; }\n.ldr-badge.approved { color: var(--green); background: var(--green-soft); }\n.ldr-badge.pending { color: var(--orange); background: var(--orange-soft); }\n.ldr-badge.rejected { color: var(--red); background: var(--red-soft); }\n.ldr-badge.other { color: #52677b; background: #edf2f7; }\n\n.ldr-empty { padding: 70px 20px; text-align: center; color: var(--muted); }\n.ldr-empty-icon { font-size: 34px; margin-bottom: 8px; }\n.ldr-loader { display: none; padding: 75px 20px; text-align: center; color: var(--muted); }\n.ldr-loader.show { display: block; }\n.ldr-spinner { width: 34px; height: 34px; margin: 0 auto 12px; border: 3px solid #dce9f5; border-top-color: var(--blue); border-radius: 50%; animation: ldr-spin .8s linear infinite; }\n@keyframes ldr-spin { to { transform: rotate(360deg); } }\n\n.ldr-pagination { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 13px 16px; border-top: 1px solid var(--line); }\n.ldr-page-info { color: var(--muted); font-size: 11px; }\n.ldr-page-controls { display: flex; gap: 7px; }\n.ldr-page-btn { width: 36px; height: 34px; padding: 0; }\n\n.ldr-toast-wrap { position: fixed; top: 18px; right: 18px; z-index: 99999; display: grid; gap: 8px; }\n.ldr-toast { max-width: 380px; padding: 12px 14px; border-radius: 10px; color: #fff; font: 500 12px 'Poppins', sans-serif; box-shadow: 0 10px 30px rgba(0,0,0,.18); animation: ldr-in .2s ease; }\n.ldr-toast.success { background: var(--green); }\n.ldr-toast.error { background: var(--red); }\n@keyframes ldr-in { from { opacity: 0; transform: translateY(-8px); } }\n\n@media (max-width: 1200px) {\n  .ldr-filters { grid-template-columns: repeat(3, 1fr); }\n  .ldr-actions { grid-column: span 3; justify-content: flex-end; }\n  .ldr-summary { grid-template-columns: repeat(3, 1fr); }\n  .ldr-table-wrap { max-height: none; }\n}\n@media (max-width: 720px) {\n  #life-discount-report { padding: 12px; }\n  .ldr-header { display: block; }\n  .ldr-title { font-size: 20px; }\n  .ldr-filters { grid-template-columns: 1fr; }\n  .ldr-actions { grid-column: auto; display: grid; grid-template-columns: 1fr 1fr; }\n  .ldr-btn-light { grid-column: span 2; }\n  .ldr-summary { grid-template-columns: 1fr 1fr; }\n  .ldr-stat:last-child { grid-column: span 2; }\n  .ldr-pagination { align-items: flex-start; flex-direction: column; }\n  .ldr-detail-grid, .ldr-finance-grid { grid-template-columns: 1fr 1fr; }\n  .ldr-modal-backdrop { padding: 8px; }\n  .ldr-modal-body { padding: 16px; }\n}\n</style>\n\n<script>\n(() => {\n  'use strict';\n\n  const API = 'life_discount_invoice_report';\n  const PAGE_SIZE = 20;\n  const state = { page: 1, totalPages: 1, loading: false, rows: [] };\n  const root = document.getElementById('life-discount-report');\n\n  root.innerHTML = `\n    <div class=\"ldr-shell\">\n      <div class=\"ldr-header\">\n        <div>\n          <h1 class=\"ldr-title\">Discount Invoice & Collection Report</h1>\n          <p class=\"ldr-subtitle\">Sales invoices, approved discounts, collections and outstanding balances</p>\n        </div>\n      </div>\n\n      <section class=\"ldr-card ldr-filter-card\">\n        <div class=\"ldr-quick-filters\">\n          <button id=\"ldr-today\" class=\"ldr-quick-btn\">Today</button>\n          <button id=\"ldr-yesterday\" class=\"ldr-quick-btn\">Yesterday</button>\n          <button id=\"ldr-this-month\" class=\"ldr-quick-btn active\">This Month (6th–5th)</button>\n          <button id=\"ldr-last-month\" class=\"ldr-quick-btn\">Last Month (6th–5th)</button>\n        </div>\n        <div class=\"ldr-filters\">\n          <div class=\"ldr-field\"><label>From Date *</label><input id=\"ldr-from\" class=\"ldr-input\" type=\"date\"></div>\n          <div class=\"ldr-field\"><label>To Date *</label><input id=\"ldr-to\" class=\"ldr-input\" type=\"date\"></div>\n          <div class=\"ldr-field\"><label>Branch</label><select id=\"ldr-branch\" class=\"ldr-input\"><option value=\"\">All Branches</option></select></div>\n          <div class=\"ldr-field\"><label>Approval Status</label><select id=\"ldr-status\" class=\"ldr-input\"><option value=\"\">All Statuses</option><option>Approved</option><option>Pending Approval</option><option>Rejected</option></select></div>\n          <div class=\"ldr-field\"><label>Approval Level</label><select id=\"ldr-level\" class=\"ldr-input\"><option value=\"\">All Levels</option><option>L1</option><option>L2</option><option>L3</option><option>L4</option></select></div>\n          <div class=\"ldr-field\"><label>Search</label><input id=\"ldr-search\" class=\"ldr-input\" type=\"search\" placeholder=\"Invoice, client, mobile or referring name\"></div>\n          <div class=\"ldr-actions\">\n            <button id=\"ldr-reset\" class=\"ldr-btn ldr-btn-light\">Reset</button>\n            <button id=\"ldr-run\" class=\"ldr-btn ldr-btn-primary\">View Report</button>\n            <button id=\"ldr-export\" class=\"ldr-btn ldr-btn-export\">Export Excel</button>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"ldr-summary\">\n        <div class=\"ldr-card ldr-stat invoice\"><div class=\"ldr-stat-label\">Invoices</div><div id=\"ldr-count\" class=\"ldr-stat-value\">0</div></div>\n        <div class=\"ldr-card ldr-stat sales\"><div class=\"ldr-stat-label\">Before Bill Total (Incl. 5% GST)</div><div id=\"ldr-original\" class=\"ldr-stat-value\">₹0</div></div>\n        <div class=\"ldr-card ldr-stat sales\"><div class=\"ldr-stat-label\">Grand Total</div><div id=\"ldr-grand\" class=\"ldr-stat-value\">₹0</div></div>\n        <div class=\"ldr-card ldr-stat paid\"><div class=\"ldr-stat-label\">Paid Amount</div><div id=\"ldr-paid\" class=\"ldr-stat-value\">₹0</div></div>\n        <div class=\"ldr-card ldr-stat discount\"><div class=\"ldr-stat-label\">Discount Used</div><div id=\"ldr-discount\" class=\"ldr-stat-value\">₹0</div></div>\n        <div class=\"ldr-card ldr-stat outstanding\"><div class=\"ldr-stat-label\">Outstanding</div><div id=\"ldr-outstanding\" class=\"ldr-stat-value\">₹0</div></div>\n      </section>\n\n      <section class=\"ldr-card ldr-table-card\">\n        <div class=\"ldr-table-head\"><strong>Invoice Details</strong><span id=\"ldr-result-count\" class=\"ldr-result-count\">0 records</span></div>\n        <div id=\"ldr-loader\" class=\"ldr-loader\"><div class=\"ldr-spinner\"></div>Loading report…</div>\n        <div id=\"ldr-table-wrap\" class=\"ldr-table-wrap\">\n          <table class=\"ldr-table\">\n            <thead><tr>\n              <th>#</th><th>Invoice ID</th><th>Invoice Date</th><th>Branch</th><th>Client Name</th><th>Mobile</th><th>Referring Name</th><th style=\"text-align:right\">Before Bill Total<br>(Incl. 5% GST)</th>\n              <th style=\"text-align:right\">Grand Total</th><th style=\"text-align:right\">Paid Amount</th><th style=\"text-align:right\">Discount Used</th>\n              <th>Discount %</th><th>L1–L4 Approval Details</th><th>Status</th><th style=\"text-align:right\">Outstanding</th><th>Payment Entries</th><th>Details</th>\n            </tr></thead>\n            <tbody id=\"ldr-body\"></tbody>\n          </table>\n        </div>\n        <div class=\"ldr-pagination\">\n          <span id=\"ldr-page-info\" class=\"ldr-page-info\">Page 1 of 1</span>\n          <div class=\"ldr-page-controls\">\n            <button id=\"ldr-first\" class=\"ldr-btn ldr-btn-light ldr-page-btn\" title=\"First page\">«</button>\n            <button id=\"ldr-prev\" class=\"ldr-btn ldr-btn-light ldr-page-btn\" title=\"Previous page\">‹</button>\n            <button id=\"ldr-next\" class=\"ldr-btn ldr-btn-light ldr-page-btn\" title=\"Next page\">›</button>\n            <button id=\"ldr-last\" class=\"ldr-btn ldr-btn-light ldr-page-btn\" title=\"Last page\">»</button>\n          </div>\n        </div>\n      </section>\n    </div>\n    <div id=\"ldr-modal-backdrop\" class=\"ldr-modal-backdrop\" aria-hidden=\"true\">\n      <div class=\"ldr-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ldr-modal-title\">\n        <div class=\"ldr-modal-head\">\n          <div><h2 id=\"ldr-modal-title\">Invoice Details</h2><p id=\"ldr-modal-subtitle\"></p></div>\n          <button id=\"ldr-modal-close\" class=\"ldr-modal-close\" aria-label=\"Close\">×</button>\n        </div>\n        <div id=\"ldr-modal-body\" class=\"ldr-modal-body\"></div>\n      </div>\n    </div>\n    <div id=\"ldr-toasts\" class=\"ldr-toast-wrap\"></div>`;\n\n  const $ = id => document.getElementById(id);\n  const els = {\n    from: $('ldr-from'), to: $('ldr-to'), branch: $('ldr-branch'), status: $('ldr-status'), level: $('ldr-level'), search: $('ldr-search'),\n    run: $('ldr-run'), reset: $('ldr-reset'), export: $('ldr-export'), loader: $('ldr-loader'), tableWrap: $('ldr-table-wrap'), body: $('ldr-body'),\n    resultCount: $('ldr-result-count'), pageInfo: $('ldr-page-info'), first: $('ldr-first'), prev: $('ldr-prev'), next: $('ldr-next'), last: $('ldr-last')\n  };\n\n  function iso(date) {\n    const y = date.getFullYear();\n    const m = String(date.getMonth() + 1).padStart(2, '0');\n    const d = String(date.getDate()).padStart(2, '0');\n    return `${y}-${m}-${d}`;\n  }\n\n  function setDefaultDates() {\n    const now = new Date();\n    setBusinessMonth(0, false);\n  }\n\n  function businessRange(offset) {\n    const now = new Date();\n    let startYear = now.getFullYear();\n    let startMonth = now.getMonth();\n    if (now.getDate() < 6) startMonth -= 1;\n    startMonth += offset;\n    const from = new Date(startYear, startMonth, 6);\n    const to = new Date(from.getFullYear(), from.getMonth() + 1, 5);\n    return {from, to};\n  }\n\n  function markQuick(id) {\n    root.querySelectorAll('.ldr-quick-btn').forEach(btn => btn.classList.toggle('active', btn.id === id));\n  }\n\n  function setBusinessMonth(offset, reload = true) {\n    const range = businessRange(offset);\n    els.from.value = iso(range.from);\n    els.to.value = iso(range.to);\n    markQuick(offset === 0 ? 'ldr-this-month' : 'ldr-last-month');\n    if (reload) loadReport(1);\n  }\n\n  function setSingleDay(dayOffset, buttonId) {\n    const date = new Date();\n    date.setDate(date.getDate() + dayOffset);\n    els.from.value = iso(date);\n    els.to.value = iso(date);\n    markQuick(buttonId);\n    loadReport(1);\n  }\n\n  function esc(value) {\n    return String(value == null ? '' : value).replace(/[&<>'\"]/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;',\"'\":'&#39;','\"':'&quot;'}[ch]));\n  }\n\n  function money(value) {\n    return '₹' + Number(value || 0).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});\n  }\n\n  function dateText(value) {\n    if (!value) return '—';\n    const parts = String(value).slice(0, 10).split('-');\n    if (parts.length !== 3) return esc(value);\n    return `${parts[2]}-${parts[1]}-${parts[0]}`;\n  }\n\n  function toast(message, type = 'success') {\n    const node = document.createElement('div');\n    node.className = `ldr-toast ${type}`;\n    node.textContent = message;\n    $('ldr-toasts').appendChild(node);\n    setTimeout(() => node.remove(), 3500);\n  }\n\n  async function callApi(args) {\n    const query = new URLSearchParams();\n    Object.keys(args || {}).forEach(key => {\n      const value = args[key];\n      if (value !== undefined && value !== null) query.append(key, String(value));\n    });\n\n    const response = await fetch(`/api/method/${API}?${query.toString()}`, {\n      method: 'GET',\n      credentials: 'same-origin',\n      headers: { 'Accept': 'application/json' },\n      cache: 'no-store'\n    });\n\n    let payload = {};\n    try { payload = await response.json(); }\n    catch (e) { throw new Error(`Server returned HTTP ${response.status}.`); }\n\n    if (!response.ok) {\n      void 0;\n      let message = payload.exception || payload.exc_type || payload.message || `Request failed with HTTP ${response.status}`;\n      if (payload._server_messages) {\n        try {\n          const messages = JSON.parse(payload._server_messages);\n          if (messages.length) {\n            const parsed = JSON.parse(messages[0]);\n            message = parsed.message || message;\n          }\n        } catch (e) {}\n      }\n      throw new Error(String(message).split('\\n').pop());\n    }\n\n    const data = payload.message;\n    if (!data || !data.success) throw new Error((data && data.message) || 'Invalid response from server.');\n    return data;\n  }\n\n  function filters(extra = {}) {\n    return Object.assign({\n      action: 'report', from_date: els.from.value, to_date: els.to.value,\n      branch: els.branch.value, approval_status: els.status.value, approval_level: els.level.value,\n      search: els.search.value.trim(), page: state.page, page_length: PAGE_SIZE\n    }, extra);\n  }\n\n  function validate() {\n    if (!els.from.value || !els.to.value) { toast('Please select From Date and To Date.', 'error'); return false; }\n    if (els.from.value > els.to.value) { toast('From Date cannot be after To Date.', 'error'); return false; }\n    return true;\n  }\n\n  function setLoading(on) {\n    state.loading = on;\n    els.loader.classList.toggle('show', on);\n    els.tableWrap.style.display = on ? 'none' : 'block';\n    [els.run, els.export, els.first, els.prev, els.next, els.last].forEach(b => b.disabled = on);\n  }\n\n  function statusBadge(status) {\n    const text = status || 'Not Set';\n    let cls = 'other';\n    if (/approved/i.test(text)) cls = 'approved';\n    else if (/pending/i.test(text)) cls = 'pending';\n    else if (/rejected/i.test(text)) cls = 'rejected';\n    return `<span class=\"ldr-badge ${cls}\">${esc(text)}</span>`;\n  }\n\n  function updateSummary(s = {}) {\n    $('ldr-count').textContent = Number(s.invoice_count || 0).toLocaleString('en-IN');\n    $('ldr-original').textContent = money(s.total_original_bill);\n    $('ldr-grand').textContent = money(s.total_grand_total);\n    $('ldr-paid').textContent = money(s.total_paid);\n    $('ldr-discount').textContent = money(s.total_discount);\n    $('ldr-outstanding').textContent = money(s.total_outstanding);\n  }\n\n  function renderRows(rows, page) {\n    if (!rows.length) {\n      els.body.innerHTML = `<tr><td colspan=\"17\"><div class=\"ldr-empty\"><div class=\"ldr-empty-icon\">⌕</div><strong>No records found</strong><br><span>Change the filters and try again.</span></div></td></tr>`;\n      return;\n    }\n    els.body.innerHTML = rows.map((r, i) => `\n      <tr>\n        <td class=\"ldr-muted\">${((page - 1) * PAGE_SIZE) + i + 1}</td>\n        <td><a class=\"ldr-link\" target=\"_blank\" href=\"/app/sales-invoice/${encodeURIComponent(r.sales_invoice)}\">${esc(r.sales_invoice)}</a></td>\n        <td>${dateText(r.invoice_date)}</td><td>${esc(r.branch || '—')}</td><td><strong>${esc(r.client_name || '—')}</strong></td>\n        <td title=\"${esc(r.mobile_number || 'Mobile number unavailable')}\">${esc(r.masked_mobile || '—')}</td><td>${esc(r.referring_name || '—')}</td><td class=\"ldr-money\">${money(r.original_bill_total)}</td>\n        <td class=\"ldr-money\">${money(r.grand_total)}</td><td class=\"ldr-money\">${money(r.paid_amount)}</td><td class=\"ldr-money\">${money(r.discount_used)}</td>\n        <td>${Number(r.discount_percentage || 0).toFixed(2)}%</td>\n        <td class=\"ldr-approver\">${esc(r.approved_by || '—')}<br><span class=\"ldr-muted\">${esc(r.approval_breakup || '')}</span></td>\n        <td>${statusBadge(r.approval_status)}</td><td class=\"ldr-money\">${money(r.outstanding_amount)}</td>\n        <td class=\"ldr-approver\">${esc(r.payment_entries || '—')}</td>\n        <td><button class=\"ldr-view-btn\" data-row-index=\"${i}\">View Details</button></td>\n      </tr>`).join('');\n  }\n\n  function detail(label, value) {\n    return `<div class=\"ldr-detail\"><div class=\"ldr-detail-label\">${esc(label)}</div><div class=\"ldr-detail-value\">${value || '—'}</div></div>`;\n  }\n\n  function openDetails(row) {\n    if (!row) return;\n    $('ldr-modal-title').textContent = row.sales_invoice || 'Invoice Details';\n    $('ldr-modal-subtitle').textContent = `${dateText(row.invoice_date)} · ${row.branch || 'Branch not set'}`;\n    $('ldr-modal-body').innerHTML = `\n      <section class=\"ldr-modal-section\">\n        <h3 class=\"ldr-section-title\">Client & Invoice Information</h3>\n        <div class=\"ldr-detail-grid\">\n          ${detail('Client Name', esc(row.client_name || '—'))}\n          ${detail('Masked Mobile', esc(row.masked_mobile || '—'))}\n          ${detail('Referring Name', esc(row.referring_name || '—'))}\n          ${detail('Invoice Date', dateText(row.invoice_date))}\n          ${detail('Branch', esc(row.branch || '—'))}\n          ${detail('Approval Status', statusBadge(row.approval_status))}\n        </div>\n      </section>\n      <section class=\"ldr-modal-section\">\n        <h3 class=\"ldr-section-title\">Financial Summary</h3>\n        <div class=\"ldr-finance-grid\">\n          <div class=\"ldr-finance\"><div class=\"ldr-detail-label\">Before Bill Total (Incl. 5% GST)</div><div class=\"ldr-detail-value\">${money(row.original_bill_total)}</div></div>\n          <div class=\"ldr-finance\"><div class=\"ldr-detail-label\">Grand Total</div><div class=\"ldr-detail-value\">${money(row.grand_total)}</div></div>\n          <div class=\"ldr-finance\"><div class=\"ldr-detail-label\">Paid Amount</div><div class=\"ldr-detail-value\">${money(row.paid_amount)}</div></div>\n          <div class=\"ldr-finance discount\"><div class=\"ldr-detail-label\">Discount Used</div><div class=\"ldr-detail-value\">${money(row.discount_used)}</div></div>\n          <div class=\"ldr-finance outstanding\"><div class=\"ldr-detail-label\">Outstanding</div><div class=\"ldr-detail-value\">${money(row.outstanding_amount)}</div></div>\n        </div>\n      </section>\n      <section class=\"ldr-modal-section\">\n        <h3 class=\"ldr-section-title\">Discount Approval</h3>\n        <div class=\"ldr-detail-grid\">\n          ${detail('Total Discount %', `${Number(row.discount_percentage || 0).toFixed(2)}%`)}\n          ${detail('L1–L4 Approval Details', esc(row.approved_by || '—'))}\n          ${detail('Approved At', esc(row.latest_approval_at || '—'))}\n        </div>\n        <div class=\"ldr-modal-note\" style=\"margin-top:10px\"><strong>Approval breakup:</strong><br>${esc(row.approval_breakup || 'No breakup available')}</div>\n      </section>\n      <section class=\"ldr-modal-section\">\n        <h3 class=\"ldr-section-title\">Collection Details</h3>\n        <div class=\"ldr-detail-grid\">\n          ${detail('Payment Entries', esc(row.payment_entries || '—'))}\n          ${detail('Last Payment Date', dateText(row.last_payment_date))}\n          ${detail('Balance Due', money(row.outstanding_amount))}\n        </div>\n      </section>\n      <div class=\"ldr-modal-actions\">\n        <button class=\"ldr-btn ldr-btn-light\" id=\"ldr-modal-done\">Close</button>\n        <a class=\"ldr-btn ldr-btn-primary\" target=\"_blank\" href=\"/app/sales-invoice/${encodeURIComponent(row.sales_invoice)}\">Open Sales Invoice</a>\n      </div>`;\n    $('ldr-modal-backdrop').classList.add('show');\n    $('ldr-modal-backdrop').setAttribute('aria-hidden', 'false');\n    document.body.style.overflow = 'hidden';\n    $('ldr-modal-done').addEventListener('click', closeDetails);\n  }\n\n  function closeDetails() {\n    $('ldr-modal-backdrop').classList.remove('show');\n    $('ldr-modal-backdrop').setAttribute('aria-hidden', 'true');\n    document.body.style.overflow = '';\n  }\n\n  function updatePagination(p) {\n    state.page = Number(p.page || 1); state.totalPages = Number(p.total_pages || 1);\n    const total = Number(p.total_rows || 0);\n    els.resultCount.textContent = `${total.toLocaleString('en-IN')} record${total === 1 ? '' : 's'}`;\n    els.pageInfo.textContent = `Page ${state.page} of ${state.totalPages} · ${total.toLocaleString('en-IN')} records`;\n    els.first.disabled = els.prev.disabled = state.page <= 1;\n    els.next.disabled = els.last.disabled = state.page >= state.totalPages;\n  }\n\n  async function loadReport(page = 1) {\n    if (!validate() || state.loading) return;\n    state.page = page; setLoading(true);\n    try {\n      const data = await callApi(filters());\n      state.rows = data.data || [];\n      renderRows(state.rows, state.page); updateSummary(data.summary); updatePagination(data.pagination || {});\n    } catch (e) {\n      renderRows([], 1); updateSummary({}); updatePagination({page: 1, total_pages: 1, total_rows: 0});\n      toast(e.message || 'Unable to load report.', 'error');\n    } finally { setLoading(false); }\n  }\n\n  async function loadBranches() {\n    try {\n      const data = await callApi({action: 'branches'});\n      (data.branches || []).forEach(name => {\n        const option = document.createElement('option'); option.value = name; option.textContent = name; els.branch.appendChild(option);\n      });\n    } catch (e) { toast('Unable to load branch list.', 'error'); }\n  }\n\n  function xml(value) { return String(value == null ? '' : value).replace(/[<>&'\\\"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;',\"'\":'&apos;','\"':'&quot;'}[c])); }\n\n  function downloadExcel(rows) {\n    const headers = ['Sales Invoice ID','Invoice Date','Branch','Client Name','Masked Mobile','Referring Name','Before Bill Total (Incl. 5% GST)','Grand Total','Paid Amount','Discount Used','Discount %','L1-L4 Approval Details','Approval Breakup','Approval Status','Outstanding Amount','Payment Entries','Last Payment Date'];\n    const keys = ['sales_invoice','invoice_date','branch','client_name','masked_mobile','referring_name','original_bill_total','grand_total','paid_amount','discount_used','discount_percentage','approved_by','approval_breakup','approval_status','outstanding_amount','payment_entries','last_payment_date'];\n    const numeric = new Set(['original_bill_total','grand_total','paid_amount','discount_used','discount_percentage','outstanding_amount']);\n    const rowXml = [headers].concat(rows.map(r => keys.map(k => r[k] == null ? '' : r[k]))).map((row, ri) =>\n      `<Row>${row.map((v, ci) => {\n        const key = ri ? keys[ci] : '';\n        const type = ri && numeric.has(key) ? 'Number' : 'String';\n        return `<Cell><Data ss:Type=\"${type}\">${xml(v)}</Data></Cell>`;\n      }).join('')}</Row>`).join('');\n    const content = `<?xml version=\"1.0\"?><Workbook xmlns=\"urn:schemas-microsoft-com:office:spreadsheet\" xmlns:ss=\"urn:schemas-microsoft-com:office:spreadsheet\"><Worksheet ss:Name=\"Discount Report\"><Table>${rowXml}</Table></Worksheet></Workbook>`;\n    const blob = new Blob([content], {type: 'application/vnd.ms-excel;charset=utf-8'});\n    const url = URL.createObjectURL(blob); const a = document.createElement('a');\n    a.href = url; a.download = `Discount_Invoice_Report_${els.from.value}_to_${els.to.value}.xls`;\n    document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000);\n  }\n\n  async function exportReport() {\n    if (!validate() || state.loading) return;\n    setLoading(true);\n    try {\n      const data = await callApi(filters({page: 1, page_length: 5000, export: 1}));\n      const rows = data.data || [];\n      if (!rows.length) { toast('No records available to export.', 'error'); return; }\n      downloadExcel(rows); toast(`${rows.length} records exported successfully.`);\n    } catch (e) { toast(e.message || 'Excel export failed.', 'error'); }\n    finally { setLoading(false); }\n  }\n\n  els.run.addEventListener('click', () => loadReport(1));\n  els.export.addEventListener('click', exportReport);\n  els.reset.addEventListener('click', () => { setDefaultDates(); els.branch.value = ''; els.status.value = ''; els.level.value = ''; els.search.value = ''; loadReport(1); });\n  $('ldr-today').addEventListener('click', () => setSingleDay(0, 'ldr-today'));\n  $('ldr-yesterday').addEventListener('click', () => setSingleDay(-1, 'ldr-yesterday'));\n  $('ldr-this-month').addEventListener('click', () => setBusinessMonth(0));\n  $('ldr-last-month').addEventListener('click', () => setBusinessMonth(-1));\n  els.from.addEventListener('change', () => markQuick(''));\n  els.to.addEventListener('change', () => markQuick(''));\n  els.search.addEventListener('keydown', e => { if (e.key === 'Enter') loadReport(1); });\n  els.body.addEventListener('click', e => {\n    const button = e.target.closest('.ldr-view-btn');\n    if (button) openDetails(state.rows[Number(button.dataset.rowIndex)]);\n  });\n  $('ldr-modal-close').addEventListener('click', closeDetails);\n  $('ldr-modal-backdrop').addEventListener('click', e => { if (e.target.id === 'ldr-modal-backdrop') closeDetails(); });\n  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDetails(); });\n  els.first.addEventListener('click', () => loadReport(1));\n  els.prev.addEventListener('click', () => loadReport(Math.max(1, state.page - 1)));\n  els.next.addEventListener('click', () => loadReport(Math.min(state.totalPages, state.page + 1)));\n  els.last.addEventListener('click', () => loadReport(state.totalPages));\n\n  setDefaultDates();\n  loadBranches().then(() => loadReport(1));\n})();\n</script>\n","css":".navbar{display:none;}\n.web-footer{display:none;}","javascript":""}
