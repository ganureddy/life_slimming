{"route":"new-client-registration","name":"new-client-registration","modified":"2026-08-18 14:09:50.126561","title":"New Client Registration","html":"<div id=\"cr-root\">\n<style>\n\n:root{--g900:#0F3D1E;--g800:#14501F;--g700:#1B5E20;--g600:#2E7D32;--g500:#43A047;--g400:#66BB6A;--g100:#E8F5E9;--g50:#F3FAF4;\n --ink:#152418;--mut:#5F6F63;--line:#DCE9DE;--red:#C62828;--redbg:#FDECEA;--amb:#E65100;--ambbg:#FFF3E0;--blu:#1565C0;--blubg:#E3F2FD;\n --yel:#F9A825;--org:#EF6C00;--blk:#212121;\n --shadow:0 1px 2px rgba(15,61,30,.06),0 4px 14px rgba(15,61,30,.07);--disp:'Archivo',system-ui,sans-serif;--body:'Inter',system-ui,sans-serif}\n*{margin:0;padding:0;box-sizing:border-box}\n#cr-root{font-family:var(--body);background:var(--g50);color:var(--ink);font-size:13.5px;line-height:1.45;background-image:radial-gradient(circle at 85% -10%,rgba(67,160,71,.08),transparent 45%)}\nbutton{font-family:inherit;cursor:pointer}\n.num{font-variant-numeric:tabular-nums}\n.hdr{position:sticky;top:0;z-index:60;background:linear-gradient(135deg,var(--g900),var(--g700) 70%,var(--g600));color:#fff;box-shadow:0 2px 12px rgba(15,61,30,.25)}\n.hdr-in{max-width:1380px;margin:0 auto;padding:13px 24px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}\n.logo{display:flex;align-items:center;gap:12px}\n.logo-mark{width:40px;height:40px;border-radius:10px;background:#fff;color:var(--g700);display:flex;align-items:center;justify-content:center;font-family:var(--disp);font-weight:800;font-size:18px}\n.logo h1{font-family:var(--disp);font-size:15.5px;font-weight:700;line-height:1.15}\n.logo small{display:block;font-weight:500;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#BFE3C4}\n.hchip{margin-left:auto;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);padding:7px 15px;border-radius:99px;font-size:11.5px;font-weight:700}\n.wrap{max-width:1380px;margin:0 auto;padding:18px 24px 60px;display:grid;grid-template-columns:1fr 350px;gap:16px;align-items:start}\n.card{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:16px 18px;margin-bottom:14px}\n.card h3{font-family:var(--disp);font-size:13.5px;font-weight:800;color:var(--g900);margin-bottom:12px;display:flex;align-items:center;gap:9px}\n.card h3 .stp{background:linear-gradient(135deg,var(--g600),var(--g700));color:#fff;width:24px;height:24px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:11.5px}\n.fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}\n.fg{display:flex;flex-direction:column;gap:4px;position:relative}\n.fg label{font-size:10px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:var(--mut)}\n.fg label .req{color:var(--red)}\n.fg input,.fg select,.fg textarea{border:1.5px solid var(--line);border-radius:9px;padding:9px 11px;font-family:var(--body);font-size:13px;background:#fff;color:var(--ink);outline:none;transition:border .15s}\n.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--g500)}\n.fg .hint{font-size:10px;color:var(--mut)}\n.fg.full{grid-column:1/-1}\n/* inline per-field error */\n.fg .err{display:none;font-size:10.5px;font-weight:700;color:var(--red);margin-top:2px;line-height:1.3}\n.fg.has-err .err{display:block}\n.fg.has-err input,.fg.has-err select,.fg.has-err textarea{border-color:var(--red);box-shadow:0 0 0 2px rgba(198,40,40,.12)}\n.fg.ok input,.fg.ok select{border-color:var(--g500)}\n/* link typeahead dropdown */\n.lk{position:relative}\n.lk-dd{position:absolute;top:100%;left:0;right:0;z-index:80;background:#fff;border:1.5px solid var(--line);border-top:none;border-radius:0 0 10px 10px;box-shadow:0 8px 20px rgba(15,61,30,.14);max-height:240px;overflow-y:auto;display:none}\n.lk-dd.show{display:block}\n.lk-dd .it{padding:8px 11px;font-size:12.5px;cursor:pointer;border-bottom:1px solid #F0F5F1}\n.lk-dd .it:hover,.lk-dd .it.hi{background:var(--g50)}\n.lk-dd .it b{color:var(--g800)}\n.lk-dd .it small{display:block;color:var(--mut);font-size:10px;font-variant-numeric:tabular-nums}\n.lk-dd .empty{padding:10px 11px;font-size:11.5px;color:var(--mut)}\n.lk-set{border-color:var(--g500)!important}\n.seg{display:flex;gap:0;border:1.5px solid var(--line);border-radius:10px;overflow:hidden}\n.seg button{flex:1;border:none;background:#fff;padding:9px 6px;font-weight:800;font-size:12px;color:var(--mut);transition:all .15s}\n.seg button.on{background:linear-gradient(135deg,var(--g600),var(--g700));color:#fff}\n.seg button.on.ub{background:linear-gradient(135deg,#78909C,#546E7A)}\n.risk-tbl{width:100%;border-collapse:collapse;font-size:11.5px;margin-top:8px}\n.risk-tbl th{background:var(--g50);text-align:left;padding:7px 9px;font-size:9.5px;letter-spacing:1px;text-transform:uppercase;font-weight:800;color:var(--g800);border-bottom:2px solid var(--line)}\n.risk-tbl td{padding:7px 9px;border-bottom:1px solid #EEF4EF}\n.risk-tbl tr{cursor:pointer;transition:background .12s}\n.risk-tbl tr:hover td{background:var(--g50)}\n.risk-tbl tr.sel td{background:var(--g100)}\n.rdot{display:inline-block;width:12px;height:12px;border-radius:50%;margin-right:7px;vertical-align:-1px}\n.riskbadge{display:inline-flex;align-items:center;gap:8px;border-radius:99px;padding:7px 16px;font-weight:800;font-size:12px;font-family:var(--disp);color:#fff;letter-spacing:.4px}\n.upl{border:2px dashed var(--g400);border-radius:11px;padding:14px;text-align:center;background:var(--g50);cursor:pointer;transition:all .15s;font-size:12px;color:var(--g700);font-weight:700}\n.upl:hover{background:var(--g100)}\n.upl input{display:none}\n.btn{border:none;border-radius:10px;padding:12px 24px;font-weight:800;font-size:13.5px;transition:transform .12s}\n.btn:hover{transform:translateY(-1px)}\n.btn-g{background:linear-gradient(135deg,var(--g600),var(--g700));color:#fff;box-shadow:0 3px 10px rgba(27,94,32,.3)}\n.btn-o{background:#fff;color:var(--g700);border:1.5px solid var(--g500)}\n.btn-sm{padding:6px 13px;font-size:11.5px;border-radius:8px}\n.rail{position:sticky;top:80px}\n.pv{background:linear-gradient(160deg,#fff,var(--g50));border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:18px;text-align:center;margin-bottom:14px;position:relative;overflow:hidden}\n.pv::before{content:\"\";position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(90deg,var(--g500),var(--g700))}\n.pv .av{width:66px;height:66px;border-radius:50%;background:linear-gradient(135deg,var(--g600),var(--g800));color:#fff;font-family:var(--disp);font-weight:800;font-size:24px;display:flex;align-items:center;justify-content:center;margin:4px auto 8px}\n.pv .nm{font-family:var(--disp);font-weight:800;font-size:17px;color:var(--g900)}\n.pv .al{font-size:11px;color:var(--mut)}\n.pv .meta{font-size:11.5px;color:var(--mut);margin-top:3px}\n.pv .row2{display:flex;justify-content:center;gap:8px;margin-top:10px;flex-wrap:wrap}\n.pill{display:inline-block;padding:4px 11px;border-radius:99px;font-size:10px;font-weight:800;letter-spacing:.4px}\n.p-g{background:var(--g100);color:var(--g800)}.p-r{background:var(--redbg);color:var(--red)}.p-a{background:var(--ambbg);color:var(--amb)}.p-b{background:var(--blubg);color:var(--blu)}.p-gr{background:#ECEFF1;color:#546E7A}\n.tbl{width:100%;border-collapse:collapse;font-size:12px}\n.tbl th{background:var(--g50);color:var(--g800);text-align:left;padding:8px 9px;font-size:9.5px;letter-spacing:.9px;text-transform:uppercase;font-weight:800;border-bottom:2px solid var(--line)}\n.tbl td{padding:8px 9px;border-bottom:1px solid #EEF4EF;vertical-align:middle}\n.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--g900);color:#fff;padding:12px 22px;border-radius:11px;font-weight:600;font-size:13px;z-index:400;opacity:0;transition:all .3s;display:flex;gap:10px}\n.toast.on{opacity:1;transform:translateX(-50%)}\n.toast .tk{color:#7CF29A;font-weight:800}\n.ftr{max-width:1380px;margin:0 auto;padding:0 24px 26px;text-align:center;font-size:11px;color:var(--mut)}\n@media (max-width:980px){.wrap{grid-template-columns:1fr}.rail{position:static}}\n\n</style>\n\n<div class=\"wrap\">\n <div><!-- ================= FORM ================= -->\n\n  <div class=\"card\"><h3><span class=\"stp\">1</span>Client Identity</h3>\n   <div class=\"fgrid\">\n    <div class=\"fg\" id=\"fg-fName\"><label>Client Name <span class=\"req\">*</span></label><input id=\"fName\" placeholder=\"Full name\"><span class=\"err\" id=\"e-fName\"></span></div>\n    <div class=\"fg\"><label>Alias Name</label><input id=\"fAlias\" placeholder=\"Known as / nickname\"></div>\n    <div class=\"fg\" id=\"fg-fGender\"><label>Gender <span class=\"req\">*</span></label><select id=\"fGender\"><option value=\"\">— select —</option><option>Female</option><option>Male</option><option>Other</option></select><span class=\"err\" id=\"e-fGender\"></span></div>\n    <div class=\"fg\" id=\"fg-fDob\"><label>Date of Birth <span class=\"req\">*</span></label><input type=\"date\" id=\"fDob\"><span class=\"hint\" id=\"ageHint\">Age auto-calculates from DOB</span><span class=\"err\" id=\"e-fDob\"></span></div>\n    <div class=\"fg\"><label>Age (auto)</label><input id=\"fAge\" readonly style=\"background:var(--g50);font-weight:800\" placeholder=\"—\"></div>\n    <div class=\"fg\"><label>Occupation</label><input id=\"fOcc\" placeholder=\"e.g. Software Engineer / Homemaker\"></div>\n   </div>\n  </div>\n\n  <div class=\"card\"><h3><span class=\"stp\">2</span>Contact & Address</h3>\n   <div class=\"fgrid\">\n    <div class=\"fg\" id=\"fg-fPhone\"><label>Phone Number <span class=\"req\">*</span></label><input id=\"fPhone\" maxlength=\"13\" inputmode=\"numeric\" placeholder=\"10-digit mobile\"><span class=\"err\" id=\"e-fPhone\"></span></div>\n    <div class=\"fg\" id=\"fg-fAlt\"><label>Alternative Number</label><input id=\"fAlt\" maxlength=\"13\" inputmode=\"numeric\" placeholder=\"Alternate contact\"><span class=\"err\" id=\"e-fAlt\"></span></div>\n    <div class=\"fg\" id=\"fg-fEmail\"><label>Email ID</label><input type=\"email\" id=\"fEmail\" placeholder=\"name@email.com\"><span class=\"err\" id=\"e-fEmail\"></span></div>\n    <div class=\"fg\" id=\"fg-fArea\"><label>Client Area <span class=\"req\">*</span></label><input id=\"fArea\" placeholder=\"e.g. Kukatpally, Miyapur\"><span class=\"err\" id=\"e-fArea\"></span></div>\n    <div class=\"fg full\"><label>Address</label><textarea id=\"fAddr\" rows=\"2\" placeholder=\"Door no, street, locality, city, pincode\"></textarea></div>\n   </div>\n  </div>\n\n  <div class=\"card\"><h3><span class=\"stp\">3</span>Walk-in Details</h3>\n   <div class=\"fgrid\">\n    <div class=\"fg\" id=\"fg-fWDate\"><label>Walk-in Date <span class=\"req\">*</span></label><input type=\"date\" id=\"fWDate\"><span class=\"err\" id=\"e-fWDate\"></span></div>\n    <div class=\"fg\"><label>Walk-in Type</label><select id=\"fWType\"><option>Fresh Walk-in</option><option>CC Appointment (HO assigned)</option><option>Referral</option><option>Repeat / Revisit</option><option>Camp / Event</option></select></div>\n    <div class=\"fg\"><label>Consultant Name</label><input id=\"fConsult\" placeholder=\"Consulting doctor / consultant\"></div>\n    <div class=\"fg\" id=\"fg-fWFor\"><label>Walk-in For <span class=\"req\">*</span></label><select id=\"fWFor\"><option value=\"\">— select —</option><option>Consultation Only</option><option>Walk-in for Treatment (Enquiry)</option><option>Joined for Treatment</option></select><span class=\"err\" id=\"e-fWFor\"></span></div>\n    <div class=\"fg\"><label>Department</label><select id=\"fDept\"><option>Slimming</option><option>Hair</option><option>Skin</option><option>Laser</option></select></div>\n    <div class=\"fg lk\" id=\"fg-fBranch\"><label>Branch <span class=\"req\">*</span></label>\n     <input id=\"fBranch\" placeholder=\"Type to search branch...\" autocomplete=\"off\">\n     <div class=\"lk-dd\" id=\"dd-fBranch\"></div><span class=\"err\" id=\"e-fBranch\"></span></div>\n   </div>\n  </div>\n\n  <div class=\"card\"><h3><span class=\"stp\">4</span>Booking Status & PD Form</h3>\n   <div class=\"fgrid\">\n    <div class=\"fg\" id=\"fg-book\"><label>Booked / Unbooked <span class=\"req\">*</span></label>\n     <div class=\"seg\" id=\"segBook\"><button type=\"button\" onclick=\"setBook('Booked')\">✓ Booked</button><button type=\"button\" class=\"ub\" onclick=\"setBook('Unbooked')\">Unbooked</button></div><span class=\"err\" id=\"e-book\"></span></div>\n    <div class=\"fg\"><label>PD Form Number</label><input id=\"fPDNo\" placeholder=\"e.g. PD-2026-0147\"></div>\n    <div class=\"fg full\"><label>PD Form Upload</label>\n     <label class=\"upl\">📄 <span id=\"pdLbl\">Click to upload PD form (PDF / photo)</span><input type=\"file\" id=\"fPD\" accept=\".pdf,image/*\" onchange=\"pdUp(this)\"></label></div>\n   </div>\n  </div>\n\n  <div class=\"card\"><h3><span class=\"stp\">5</span>Consultation Handling</h3>\n   <div class=\"fgrid\">\n    <div class=\"fg lk\" id=\"fg-fEmp\"><label>Consultation Taken By (Practitioner) <span class=\"req\">*</span></label>\n     <input id=\"fEmp\" placeholder=\"Type to search practitioner...\" autocomplete=\"off\">\n     <div class=\"lk-dd\" id=\"dd-fEmp\"></div><span class=\"err\" id=\"e-fEmp\"></span></div>\n    <div class=\"fg lk\" id=\"fg-fBM\"><label>Branch Manager (Practitioner)</label>\n     <input id=\"fBM\" placeholder=\"Type to search practitioner...\" autocomplete=\"off\">\n     <div class=\"lk-dd\" id=\"dd-fBM\"></div><span class=\"err\" id=\"e-fBM\"></span></div>\n   </div>\n  </div>\n\n  <div class=\"card\"><h3><span class=\"stp\">6</span>Medical Condition Risk Level <span class=\"pill p-b\" style=\"margin-left:4px\">Auto colour status</span></h3>\n   <div class=\"fgrid\">\n    <div class=\"fg\" id=\"fg-fRisk\"><label>Medical Condition Risk Level <span class=\"req\">*</span></label>\n     <select id=\"fRisk\" onchange=\"riskSel(this.value)\"><option value=\"\">— select level —</option>\n      <option>Normal</option><option>Controlled</option><option>Medical History</option><option>Active Condition</option><option>High Risk</option></select><span class=\"err\" id=\"e-fRisk\"></span></div>\n    <div class=\"fg\"><label>Auto Status</label><div id=\"riskBadge\" style=\"padding-top:3px\"><span class=\"pill p-gr\">Select a level</span></div></div>\n    <div class=\"fg full\"><label>Medical Notes</label><input id=\"fMed\" placeholder=\"Condition details — e.g. controlled BP since 2023, on medication\"></div>\n   </div>\n   <table class=\"risk-tbl\" id=\"riskTbl\">\n    <thead><tr><th>Category</th><th>Examples</th><th>Status</th></tr></thead>\n    <tbody></tbody>\n   </table>\n  </div>\n\n  <div class=\"card\"><h3><span class=\"stp\">7</span>Relative in LIFE</h3>\n   <div class=\"fgrid\">\n    <div class=\"fg\" id=\"fg-rel\"><label>Any other client in LIFE is relative to client? <span class=\"req\">*</span></label>\n     <div class=\"seg\" id=\"segRel\"><button type=\"button\" onclick=\"setRel('Yes')\">Yes</button><button type=\"button\" onclick=\"setRel('No')\">No</button></div><span class=\"err\" id=\"e-rel\"></span></div>\n    <div class=\"fg\" id=\"relName\" style=\"display:none\"><label>Relative Client Name</label><input id=\"fRelName\" placeholder=\"Existing LIFE client name\"></div>\n    <div class=\"fg lk\" id=\"relBr\" style=\"display:none\"><label>Relative's Branch</label>\n     <input id=\"fRelBr\" placeholder=\"Type to search branch...\" autocomplete=\"off\"><div class=\"lk-dd\" id=\"dd-fRelBr\"></div></div>\n   </div>\n  </div>\n\n  <div class=\"card\" style=\"display:flex;gap:12px;align-items:center;flex-wrap:wrap\">\n   <span style=\"font-size:11.5px;color:var(--mut)\">Registration applies to <b>both Booked and Unbooked</b> walk-ins — every client gets a LIFE Client ID.</span>\n   <button class=\"btn btn-o\" style=\"margin-left:auto\" onclick=\"resetForm()\">Clear Form</button>\n   <button class=\"btn btn-g\" onclick=\"saveClient()\">✓ Register Client</button>\n  </div>\n </div>\n\n <!-- ================= RIGHT RAIL ================= -->\n <aside class=\"rail\">\n  <div class=\"pv\" id=\"pvCard\"></div>\n  <div class=\"card\"><h3>Today's Registrations <span class=\"pill p-g num\" id=\"regCount\" style=\"margin-left:auto\"></span></h3>\n   <div style=\"overflow-x:auto\"><table class=\"tbl\"><thead><tr><th>Client</th><th>Booked</th><th>Risk</th></tr></thead><tbody id=\"regRows\"></tbody></table></div>\n  </div>\n </aside>\n</div>\n\n<div class=\"ftr\">LIFE SLIMMING AND COSMETIC CLINIC PVT. LTD. · Client Registration · saves to Patient (Client DocType)</div>\n<div class=\"toast\" id=\"toast\"><span class=\"tk\">✓</span><span id=\"toastMsg\"></span></div>\n\n\n<script>\n(function(){\n  \"use strict\";\n  var $=function(id){return document.getElementById(id);};\n  var esc=function(s){return String(s==null?\"\":s).replace(/</g,\"&lt;\");};\n  var ini=function(s){return s?s.split(\" \").map(function(w){return w[0];}).join(\"\").slice(0,2).toUpperCase():\"?\";};\n  function toast(m){$(\"toastMsg\").textContent=m;$(\"toast\").classList.add(\"on\");clearTimeout(toast._t);toast._t=setTimeout(function(){$(\"toast\").classList.remove(\"on\");},2800);}\n\n  /* ============ inline field-error helpers ============ */\n  function setErr(fgId, msg){\n    var fg=$(fgId); if(!fg) return;\n    fg.classList.add(\"has-err\"); fg.classList.remove(\"ok\");\n    var e=fg.querySelector(\".err\"); if(e) e.textContent=msg;\n  }\n  function clearErr(fgId, markOk){\n    var fg=$(fgId); if(!fg) return;\n    fg.classList.remove(\"has-err\");\n    if(markOk) fg.classList.add(\"ok\"); else fg.classList.remove(\"ok\");\n    var e=fg.querySelector(\".err\"); if(e) e.textContent=\"\";\n  }\n\n  /* ============ ported text/mobile formatters ============ */\n  function normMobile(raw){\n    var m=String(raw||\"\").replace(/[^\\d]/g,\"\");\n    if(/^\\d{10}$/.test(m)) return m;\n    if(/^91\\d{10}$/.test(m)) return m.slice(2);\n    return m;\n  }\n  function fmtName(v){\n    v=String(v||\"\").trim().replace(/[^a-zA-Z\\s.']/g,\"\").replace(/\\s+/g,\" \").trim();\n    if(!v) return \"\";\n    return v.split(\" \").map(function(p){ return p?p.charAt(0).toUpperCase()+p.slice(1).toLowerCase():\"\"; }).join(\" \");\n  }\n\n  /* ============ per-field validators (run BEFORE save, on blur/input) ============ */\n  // return true if valid\n  function vName(){\n    var raw=$(\"fName\").value;\n    if(!raw.trim()){ setErr(\"fg-fName\",\"Client name is required.\"); return false; }\n    var clean=fmtName(raw);\n    if(clean.replace(/[^a-zA-Z]/g,\"\").length<2){ setErr(\"fg-fName\",\"Name must contain at least 2 letters.\"); return false; }\n    clearErr(\"fg-fName\",true); return true;\n  }\n  function vGender(){\n    if(!$(\"fGender\").value){ setErr(\"fg-fGender\",\"Please select gender.\"); return false; }\n    clearErr(\"fg-fGender\",true); return true;\n  }\n  function vDob(){\n    var d=$(\"fDob\").value;\n    if(!d){ setErr(\"fg-fDob\",\"Date of birth is required.\"); return false; }\n    var dob=new Date(d), now=new Date();\n    if(dob>now){ setErr(\"fg-fDob\",\"DOB cannot be in the future.\"); return false; }\n    var a=now.getFullYear()-dob.getFullYear();\n    if(now<new Date(now.getFullYear(),dob.getMonth(),dob.getDate())) a--;\n    if(a<0||a>110){ setErr(\"fg-fDob\",\"Check DOB — age out of range.\"); return false; }\n    clearErr(\"fg-fDob\",true); return true;\n  }\n  function vPhone(){\n    var mob=normMobile($(\"fPhone\").value);\n    if(!mob){ setErr(\"fg-fPhone\",\"Mobile number is required.\"); return false; }\n    if(!/^\\d{10}$/.test(mob)){ setErr(\"fg-fPhone\",\"Must be exactly 10 digits (91 prefix is stripped).\"); return false; }\n    if(!/^[6-9]/.test(mob)){ setErr(\"fg-fPhone\",\"Must start with 6, 7, 8, or 9.\"); return false; }\n    if($(\"fPhone\").value!==mob) $(\"fPhone\").value=mob;\n    clearErr(\"fg-fPhone\",true); return true;\n  }\n  function vAlt(){\n    var v=String($(\"fAlt\").value||\"\").trim();\n    if(!v){ clearErr(\"fg-fAlt\"); return true; } // optional\n    var mob=normMobile(v);\n    if(!/^\\d{10}$/.test(mob)||!/^[6-9]/.test(mob)){ setErr(\"fg-fAlt\",\"If entered, must be a valid 10-digit number.\"); return false; }\n    if($(\"fAlt\").value!==mob) $(\"fAlt\").value=mob;\n    clearErr(\"fg-fAlt\",true); return true;\n  }\n  function vEmail(){\n    var v=String($(\"fEmail\").value||\"\").trim();\n    if(!v){ clearErr(\"fg-fEmail\"); return true; } // optional\n    if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)){ setErr(\"fg-fEmail\",\"Enter a valid email address.\"); return false; }\n    clearErr(\"fg-fEmail\",true); return true;\n  }\n  function vArea(){\n    if(!$(\"fArea\").value.trim()){ setErr(\"fg-fArea\",\"Client area is required.\"); return false; }\n    clearErr(\"fg-fArea\",true); return true;\n  }\n  function vWDate(){\n    if(!$(\"fWDate\").value){ setErr(\"fg-fWDate\",\"Walk-in date is required.\"); return false; }\n    clearErr(\"fg-fWDate\",true); return true;\n  }\n  function vWFor(){\n    if(!$(\"fWFor\").value){ setErr(\"fg-fWFor\",\"Please select walk-in reason.\"); return false; }\n    clearErr(\"fg-fWFor\",true); return true;\n  }\n  function vBranch(){\n    if(!LK.fBranch.id){ setErr(\"fg-fBranch\",\"Select a valid branch from the list.\"); return false; }\n    clearErr(\"fg-fBranch\",true); return true;\n  }\n  function vEmp(){\n    if(!LK.fEmp.id){ setErr(\"fg-fEmp\",\"Select a valid practitioner from the list.\"); return false; }\n    clearErr(\"fg-fEmp\",true); return true;\n  }\n  function vRisk(){\n    if(!$(\"fRisk\").value){ setErr(\"fg-fRisk\",\"Select a medical risk level.\"); return false; }\n    clearErr(\"fg-fRisk\",true); return true;\n  }\n  function vBook(){\n    if(!vBookVal){ setErr(\"fg-book\",\"Select Booked or Unbooked.\"); return false; }\n    clearErr(\"fg-book\",true); return true;\n  }\n  function vRel(){\n    if(!vRelVal){ setErr(\"fg-rel\",\"Please answer Yes or No.\"); return false; }\n    if(vRelVal===\"Yes\" && !$(\"fRelName\").value.trim()){ setErr(\"fg-rel\",\"Enter the relative's client name below.\"); return false; }\n    clearErr(\"fg-rel\",true); return true;\n  }\n\n  /* ============ link (typeahead) fields — store ID, show name ============ */\n  // LK[key] = {id: <docname stored>, doctype, showField, hi}\n  var LK={\n    fBranch:{doctype:\"Branch\", show:\"name\", id:\"\", ddId:\"dd-fBranch\", inId:\"fBranch\"},\n    fRelBr :{doctype:\"Branch\", show:\"name\", id:\"\", ddId:\"dd-fRelBr\", inId:\"fRelBr\"},\n    fEmp   :{doctype:\"Healthcare Practitioner\", show:\"practitioner_name\", id:\"\", ddId:\"dd-fEmp\", inId:\"fEmp\"},\n    fBM    :{doctype:\"Healthcare Practitioner\", show:\"practitioner_name\", id:\"\", ddId:\"dd-fBM\", inId:\"fBM\"}\n  };\n  var _lkT;\n  function lkSearch(key){\n    var cfg=LK[key], q=String($(cfg.inId).value||\"\").trim();\n    cfg.id=\"\"; // typing invalidates prior selection\n    $(cfg.inId).classList.remove(\"lk-set\");\n    var dd=$(cfg.ddId);\n    clearTimeout(_lkT);\n    if(q.length<2){ dd.classList.remove(\"show\"); dd.innerHTML=\"\"; return; }\n    _lkT=setTimeout(function(){\n      var fields=(cfg.show===\"name\")?[\"name\"]:[\"name\",cfg.show];\n      var filters=(cfg.show===\"name\")?[[\"name\",\"like\",\"%\"+q+\"%\"]]:[[cfg.show,\"like\",\"%\"+q+\"%\"]];\n      frappe.call({ method:\"frappe.client.get_list\",\n        args:{ doctype:cfg.doctype, fields:fields, filters:filters, order_by:cfg.show+\" asc\", limit_page_length:12 }\n      }).then(function(r){\n        var rows=r.message||[];\n        if(!rows.length){ dd.innerHTML='<div class=\"empty\">No match — keep typing</div>'; dd.classList.add(\"show\"); return; }\n        dd.innerHTML=rows.map(function(row){\n          var label=cfg.show===\"name\"?row.name:(row[cfg.show]||row.name);\n          var sub=cfg.show===\"name\"?\"\":row.name;\n          return '<div class=\"it\" data-id=\"'+esc(row.name)+'\" data-label=\"'+esc(label)+'\"><b>'+esc(label)+'</b>'+(sub?'<small>'+esc(sub)+'</small>':\"\")+'</div>';\n        }).join(\"\");\n        dd.classList.add(\"show\");\n        var its=dd.querySelectorAll(\".it\");\n        for(var i=0;i<its.length;i++){\n          its[i].onclick=function(){\n            cfg.id=this.getAttribute(\"data-id\");\n            $(cfg.inId).value=this.getAttribute(\"data-label\");\n            $(cfg.inId).classList.add(\"lk-set\");\n            dd.classList.remove(\"show\");\n            // re-validate the field that owns this link\n            if(key===\"fBranch\") vBranch();\n            if(key===\"fEmp\") vEmp();\n            pv();\n          };\n        }\n      }).catch(function(e){ void 0; });\n    },200);\n  }\n  function bindLink(key){\n    var cfg=LK[key];\n    $(cfg.inId).addEventListener(\"input\", function(){ lkSearch(key); pv(); });\n    $(cfg.inId).addEventListener(\"blur\", function(){\n      setTimeout(function(){ $(cfg.ddId).classList.remove(\"show\"); }, 180);\n    });\n  }\n\n  /* ===== Risk level -> health_flag + severity ===== */\n  var RISKS=[\n   [\"Normal\",\"No known medical condition\",\"GREEN\",\"#2E7D32\"],\n   [\"Controlled\",\"Controlled BP, controlled diabetes, thyroid\",\"YELLOW\",\"#F9A825\"],\n   [\"Medical History\",\"Previous surgery, past cardiac issue\",\"ORANGE\",\"#EF6C00\"],\n   [\"Active Condition\",\"Current infection, uncontrolled BP, active illness\",\"RED\",\"#C62828\"],\n   [\"High Risk\",\"Cardiac risk, pregnancy, severe uncontrolled condition\",\"BLACK\",\"#212121\"]];\n  function riskToFlag(level){\n    if(level===\"Normal\") return {flag:\"Green Flag\", sev:\"Controlled\"};\n    if(level===\"Controlled\") return {flag:\"Green Flag\", sev:\"Controlled\"};\n    if(level===\"Medical History\") return {flag:\"Orange Flag\", sev:\"Controlled\"};\n    if(level===\"Active Condition\") return {flag:\"Red Flag\", sev:\"Serious\"};\n    if(level===\"High Risk\") return {flag:\"Red Flag\", sev:\"Serious\"};\n    return {flag:\"\", sev:\"\"};\n  }\n  function buildRiskTbl(){\n   $(\"riskTbl\").querySelector(\"tbody\").innerHTML=RISKS.map(function(r){return '<tr data-l=\"'+r[0]+'\" onclick=\"window._crRiskPick(\\''+r[0]+'\\')\">'+\n    '<td style=\"font-weight:800\"><span class=\"rdot\" style=\"background:'+r[3]+'\"></span>'+r[0]+'</td>'+\n    '<td style=\"color:var(--mut)\">'+r[1]+'</td>'+\n    '<td><span class=\"riskbadge\" style=\"background:'+r[3]+';padding:3px 12px;font-size:10px\">'+r[2]+'</span></td></tr>';}).join(\"\");\n  }\n  window._crRiskPick=function(v){ $(\"fRisk\").value=v; riskSel(v); };\n  function riskSel(v){\n   var trs=document.querySelectorAll(\"#riskTbl tbody tr\");\n   for(var i=0;i<trs.length;i++){ trs[i].classList.toggle(\"sel\",trs[i].dataset.l===v); }\n   var r=null; for(var j=0;j<RISKS.length;j++){ if(RISKS[j][0]===v){ r=RISKS[j]; break; } }\n   $(\"riskBadge\").innerHTML=r?'<span class=\"riskbadge\" style=\"background:'+r[3]+'\">\\u25CF '+r[2]+' \\u2014 '+r[0]+'</span>':'<span class=\"pill p-gr\">Select a level</span>';\n   vRisk(); pv();\n  }\n  window.riskSel=riskSel;\n\n  function calcAge(){\n   var d=$(\"fDob\").value; if(!d){$(\"fAge\").value=\"\";return;}\n   var dob=new Date(d),now=new Date();\n   var a=now.getFullYear()-dob.getFullYear();\n   if(now<new Date(now.getFullYear(),dob.getMonth(),dob.getDate()))a--;\n   if(a<0||a>110){$(\"fAge\").value=\"\";$(\"ageHint\").textContent=\"\\u26A0 Check DOB \\u2014 age out of range\";$(\"ageHint\").style.color=\"var(--red)\";return;}\n   $(\"fAge\").value=a+\" years\";$(\"ageHint\").textContent=\"Age auto-calculated \\u2713\";$(\"ageHint\").style.color=\"var(--g600)\";pv();\n  }\n  window.calcAge=calcAge;\n\n  var vBookVal=\"\",vRelVal=\"\";\n  function setBook(v){vBookVal=v;var c=$(\"segBook\").children;for(var i=0;i<c.length;i++){c[i].classList.toggle(\"on\",c[i].textContent.indexOf(v)>=0);}vBook();pv();}\n  function setRel(v){vRelVal=v;var c=$(\"segRel\").children;for(var i=0;i<c.length;i++){c[i].classList.toggle(\"on\",c[i].textContent===v);}\n   $(\"relName\").style.display=v===\"Yes\"?\"flex\":\"none\";$(\"relBr\").style.display=v===\"Yes\"?\"flex\":\"none\";vRel();}\n  window.setBook=setBook; window.setRel=setRel;\n  function pdUp(inp){$(\"pdLbl\").textContent=inp.files.length?(\"\\u2713 \"+inp.files[0].name+\" attached\"):\"Click to upload PD form (PDF / photo)\";}\n  window.pdUp=pdUp;\n\n  function pv(){\n   var nm=$(\"fName\").value||\"New Client\";\n   var r=null,rv=$(\"fRisk\").value; for(var j=0;j<RISKS.length;j++){ if(RISKS[j][0]===rv){ r=RISKS[j]; break; } }\n   $(\"pvCard\").innerHTML='<div class=\"av\">'+ini($(\"fName\").value)+'</div>'+\n    '<div class=\"nm\">'+esc(nm)+'</div>'+\n    ($(\"fAlias\").value?'<div class=\"al\">alias: '+esc($(\"fAlias\").value)+'</div>':\"\")+\n    '<div class=\"meta\">'+([$(\"fGender\").value,$(\"fAge\").value,$(\"fArea\").value].filter(Boolean).join(\" \\u00B7 \")||\"\\u2014\")+'</div>'+\n    '<div class=\"meta num\">'+($(\"fPhone\").value||\"\")+'</div>'+\n    '<div class=\"row2\">'+\n     (vBookVal?'<span class=\"pill '+(vBookVal===\"Booked\"?\"p-g\":\"p-gr\")+'\">'+vBookVal.toUpperCase()+'</span>':\"\")+\n     ($(\"fWFor\").value?'<span class=\"pill p-b\">'+$(\"fWFor\").value.toUpperCase()+'</span>':\"\")+\n     ($(\"fPDNo\").value?'<span class=\"pill p-a num\">PD: '+esc($(\"fPDNo\").value)+'</span>':\"\")+\n    '</div>'+\n    (r?'<div style=\"margin-top:10px\"><span class=\"riskbadge\" style=\"background:'+r[3]+'\">\\u25CF '+r[2]+' \\u2014 '+r[0]+'</span></div>':\"\");\n  }\n  window.pv=pv;\n\n  /* ===== Today's registrations ===== */\n  function renderReg(){\n    return frappe.call({ method:\"frappe.client.get_list\",\n      args:{ doctype:\"Patient\", fields:[\"name\",\"patient_name\",\"custom_final_decision\",\"custom_health_flag\"],\n             filters:[[\"creation\",\">=\", new Date().toISOString().slice(0,10)+\" 00:00:00\"]],\n             order_by:\"creation desc\", limit_page_length:20 }\n    }).then(function(r){\n      var rows=r.message||[];\n      $(\"regCount\").textContent=rows.length;\n      $(\"regRows\").innerHTML=rows.map(function(c){\n        var book=c.custom_final_decision||\"\\u2014\";\n        var flag=c.custom_health_flag||\"\";\n        var color= flag.indexOf(\"Red\")>=0?\"#C62828\": flag.indexOf(\"Orange\")>=0?\"#EF6C00\":\"#2E7D32\";\n        var flagTxt= flag? flag.replace(\" Flag\",\"\").toUpperCase() : \"\\u2014\";\n        return '<tr><td><div style=\"font-weight:700\">'+esc(c.patient_name||c.name)+'</div><div style=\"font-size:10px;color:var(--mut)\" class=\"num\">'+esc(c.name)+'</div></td>'+\n        '<td><span class=\"pill '+(book===\"Booked\"?\"p-g\":\"p-gr\")+'\">'+esc(book).toUpperCase()+'</span></td>'+\n        '<td><span class=\"rdot\" style=\"background:'+color+'\"></span><span style=\"font-size:10.5px;font-weight:700\">'+flagTxt+'</span></td></tr>';\n      }).join(\"\") || '<tr><td colspan=\"3\" style=\"color:var(--mut);padding:14px\">No registrations yet today.</td></tr>';\n    }).catch(function(e){ void 0; });\n  }\n\n  /* ===== validate ALL then save -> create Patient ===== */\n  function saveClient(){\n   // run every validator; collect first failing field to focus\n   var checks=[[\"fName\",vName],[\"fGender\",vGender],[\"fDob\",vDob],[\"fPhone\",vPhone],[\"fAlt\",vAlt],[\"fEmail\",vEmail],\n     [\"fArea\",vArea],[\"fWDate\",vWDate],[\"fWFor\",vWFor],[\"fBranch\",vBranch],[\"fEmp\",vEmp],[\"fRisk\",vRisk],\n     [\"book\",vBook],[\"rel\",vRel]];\n   var firstBad=null;\n   for(var i=0;i<checks.length;i++){ if(!checks[i][1]()){ if(!firstBad) firstBad=checks[i][0]; } }\n   if(firstBad){\n     toast(\"Please fix the highlighted fields.\");\n     var el=$(firstBad); if(el && el.focus) el.focus();\n     return;\n   }\n\n   var mob=normMobile($(\"fPhone\").value);\n   var cleanName=fmtName($(\"fName\").value);\n   var rf=riskToFlag($(\"fRisk\").value);\n   var addr=[$(\"fArea\").value, $(\"fAddr\").value].filter(Boolean).join(\", \");\n\n   var doc={\n     doctype:\"Patient\",\n     first_name:cleanName,\n     sex:$(\"fGender\").value,\n     dob:$(\"fDob\").value,\n     mobile:mob,\n     phone:$(\"fAlt\").value||\"\",\n     email:$(\"fEmail\").value||\"\",\n     occupation:fmtName($(\"fOcc\").value)||\"\",\n     custom_client_address:addr,\n     custom_branch:LK.fBranch.id,\n     branch_name:LK.fBranch.id,\n     custom_employee_id:LK.fEmp.id,\n     custom_manager_name:LK.fBM.id||\"\",\n     custom_client_visited_for_:mapVisitedFor($(\"fDept\").value),\n     custom_treatment_category:mapTreatmentCat($(\"fDept\").value),\n     custom_final_decision:vBookVal===\"Booked\"?\"Booked\":\"Not-Booked\",\n     custom_health_flag:rf.flag,\n     custom_severity_update:rf.sev,\n     custom_medical_history:($(\"fRisk\").value===\"Normal\")?\"Non-Medical\":\"Medical\",\n     medical_history:$(\"fMed\").value||\"\",\n     custom_remarks:buildRemarks()\n   };\n\n   var btn=document.querySelector(\".btn-g\");\n   if(btn){ btn.disabled=true; btn.textContent=\"Checking\\u2026\"; }\n\n   // duplicate mobile check -> block\n   frappe.call({ method:\"frappe.client.get_value\",\n     args:{ doctype:\"Patient\", filters:{ mobile:mob }, fieldname:\"patient_name\" }\n   })\n   .then(function(dr){\n     var dupName=dr.message&&dr.message.patient_name;\n     if(dupName){\n       setErr(\"fg-fPhone\",\"Already registered to \"+dupName+\".\");\n       toast(\"Duplicate mobile \\u2014 registration blocked\");\n       if(btn){ btn.disabled=false; btn.textContent=\"\\u2713 Register Client\"; }\n       return;\n     }\n     if(btn){ btn.textContent=\"Saving\\u2026\"; }\n     return frappe.call({ method:\"frappe.client.insert\", args:{ doc:doc } })\n       .then(function(r){\n         var name=r.message&&r.message.name;\n         toast((name||\"Client\")+\" registered \\u2713 redirecting to billing\\u2026\");\n         renderReg();\n         setTimeout(function(){ window.location.href=\"/billing?mobile=\"+encodeURIComponent(mob); }, 900);\n       })\n       .catch(function(err){\n         void 0;\n         toast(\"Save failed: \"+((err&&err.message)||\"check console\"));\n         if(btn){ btn.disabled=false; btn.textContent=\"\\u2713 Register Client\"; }\n       });\n   })\n   .catch(function(err){\n     void 0;\n     toast(\"Duplicate check failed: \"+((err&&err.message)||\"check console\"));\n     if(btn){ btn.disabled=false; btn.textContent=\"\\u2713 Register Client\"; }\n   });\n  }\n  window.saveClient=saveClient;\n\n  function mapVisitedFor(dept){\n    if(dept===\"Slimming\") return \"Slimming\";\n    if(dept===\"Hair\") return \"Hair\";\n    if(dept===\"Skin\") return \"Skin\";\n    if(dept===\"Laser\") return \"Skin\";\n    return \"\";\n  }\n  function mapTreatmentCat(dept){\n    if(dept===\"Slimming\") return \"Slimming/Cryo\";\n    if(dept===\"Hair\") return \"Hair / PRP / GFC\";\n    if(dept===\"Skin\"||dept===\"Laser\") return \"Skin/Laser\";\n    return \"\";\n  }\n  function buildRemarks(){\n    var parts=[];\n    if($(\"fAlias\").value) parts.push(\"Alias: \"+$(\"fAlias\").value);\n    if($(\"fWDate\").value) parts.push(\"Walk-in date: \"+$(\"fWDate\").value);\n    if($(\"fWType\").value) parts.push(\"Walk-in type: \"+$(\"fWType\").value);\n    if($(\"fWFor\").value) parts.push(\"Walk-in for: \"+$(\"fWFor\").value);\n    if($(\"fConsult\").value) parts.push(\"Consultant: \"+$(\"fConsult\").value);\n    if($(\"fBM\").value) parts.push(\"Branch manager: \"+$(\"fBM\").value);\n    if($(\"fPDNo\").value) parts.push(\"PD Form: \"+$(\"fPDNo\").value);\n    if($(\"fRisk\").value) parts.push(\"Risk level: \"+$(\"fRisk\").value);\n    if(vRelVal===\"Yes\" && $(\"fRelName\").value) parts.push(\"Relative in LIFE: \"+$(\"fRelName\").value+\" (\"+($(\"fRelBr\").value||\"\")+\")\");\n    return parts.join(\" | \");\n  }\n\n  function resetForm(keepToast){\n   var els=document.querySelectorAll(\"#cr-root input,#cr-root select,#cr-root textarea\");\n   for(var i=0;i<els.length;i++){ var e=els[i]; if(e.type===\"file\")e.value=\"\"; else if(e.tagName===\"SELECT\")e.selectedIndex=0; else e.value=\"\"; e.classList.remove(\"lk-set\"); }\n   vBookVal=\"\";vRelVal=\"\";\n   LK.fBranch.id=\"\";LK.fRelBr.id=\"\";LK.fEmp.id=\"\";LK.fBM.id=\"\";\n   var sb=$(\"segBook\").children; for(var a=0;a<sb.length;a++){ sb[a].classList.remove(\"on\"); }\n   var sr=$(\"segRel\").children; for(var b=0;b<sr.length;b++){ sr[b].classList.remove(\"on\"); }\n   $(\"relName\").style.display=\"none\";$(\"relBr\").style.display=\"none\";\n   $(\"pdLbl\").textContent=\"Click to upload PD form (PDF / photo)\";\n   $(\"riskBadge\").innerHTML='<span class=\"pill p-gr\">Select a level</span>';\n   var trs=document.querySelectorAll(\"#riskTbl tbody tr\"); for(var c=0;c<trs.length;c++){ trs[c].classList.remove(\"sel\"); }\n   var fgs=document.querySelectorAll(\".fg\"); for(var k=0;k<fgs.length;k++){ fgs[k].classList.remove(\"has-err\"); fgs[k].classList.remove(\"ok\"); var er=fgs[k].querySelector(\".err\"); if(er) er.textContent=\"\"; }\n   $(\"fWDate\").value=new Date().toISOString().slice(0,10);\n   $(\"ageHint\").textContent=\"Age auto-calculates from DOB\";$(\"ageHint\").style.color=\"var(--mut)\";\n   pv(); if(!keepToast)toast(\"Form cleared\");\n  }\n  window.resetForm=resetForm;\n\n  /* ===== wire up blur/input validation (BEFORE save) ===== */\n  function bindValidation(){\n    $(\"fName\").addEventListener(\"blur\", vName);\n    $(\"fName\").addEventListener(\"input\", pv);\n    $(\"fGender\").addEventListener(\"change\", vGender);\n    $(\"fDob\").addEventListener(\"change\", function(){ calcAge(); vDob(); });\n    $(\"fPhone\").addEventListener(\"input\", function(){ var v=$(\"fPhone\").value.replace(/[^\\d+]/g,\"\"); $(\"fPhone\").value=v.slice(0,13); pv(); });\n    $(\"fPhone\").addEventListener(\"blur\", vPhone);\n    $(\"fAlt\").addEventListener(\"blur\", vAlt);\n    $(\"fEmail\").addEventListener(\"blur\", vEmail);\n    $(\"fArea\").addEventListener(\"input\", pv);\n    $(\"fArea\").addEventListener(\"blur\", vArea);\n    $(\"fWDate\").addEventListener(\"change\", vWDate);\n    $(\"fWFor\").addEventListener(\"change\", function(){ vWFor(); pv(); });\n    $(\"fRelName\").addEventListener(\"blur\", function(){ if(vRelVal===\"Yes\") vRel(); });\n  }\n\n  /* ===== init ===== */\n  function boot(){\n    $(\"fWDate\").value=new Date().toISOString().slice(0,10);\n    buildRiskTbl();\n    bindLink(\"fBranch\"); bindLink(\"fRelBr\"); bindLink(\"fEmp\"); bindLink(\"fBM\");\n    bindValidation();\n    pv();\n    renderReg();\n  }\n  if(window.frappe&&frappe.call){ boot(); }\n  else {\n    var tries=0,t=setInterval(function(){ tries++; if(window.frappe&&frappe.call){ clearInterval(t); boot(); } else if(tries>50){ clearInterval(t); toast(\"Frappe not available on this page\"); } },100);\n  }\n})();\n</script>\n\n</div>","css":".navbar{display:none;}\n.web-footer{display:none;}","javascript":""}
